# Copy to .env and fill in. NEVER commit .env.

# --- ESPN private league ---
LEAGUE_ID=123456
SEASON=2026
# Auth cookies from your browser (DevTools > Application > Cookies > espn.com).
# Include the surrounding braces on SWID, e.g. {AAAA-BBBB-CCCC}.
ESPN_S2=your_espn_s2_cookie_here
SWID={your-swid-here}

# --- Claude text generation ---
ANTHROPIC_API_KEY=sk-ant-...
# Model used for all text generators.
ANTHROPIC_MODEL=claude-sonnet-5

# --- Where posts go ---
# supabase = write to the app feed | webhook = chat | both
POST_TARGET=supabase

# --- Supabase (the app feed database) ---
SUPABASE_URL=https://your-project.supabase.co
# SERVICE ROLE key (secret! bypasses row-level security). Settings > API.
SUPABASE_SERVICE_KEY=your_service_role_key_here
# The league row id printed by supabase/schema.sql.
SUPABASE_LEAGUE_ID=d9142041-374e-4b7f-99a7-21853b86645c
SUPABASE_BUCKET=media

# --- Delivery (only used when POST_TARGET includes webhook) ---
# One of: discord | slack | groupme
WEBHOOK_PROVIDER=discord
WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
# GroupMe only: the bot id (GroupMe uses a bot id, not a plain webhook)
GROUPME_BOT_ID=

# --- Tone ---
# Default tone. Per-content-type overrides below.
TONE=roast
TONE_NOTIFICATIONS=roast
TONE_TWEETS=roast
TONE_INSTAGRAM=roast
TONE_RANKINGS=hype

# --- Scheduling ---
# Poll interval in minutes.
POLL_INTERVAL=60
# Optional: run once and exit instead of looping (true/false).
RUN_ONCE=false

# --- Insider + fan reactions ---
# A rumor is only published once this many managers report the same thing.
INSIDER_MIN_CORROBORATION=2
# UTC hour for the once-a-day Insider batch (0-23).
INSIDER_DAILY_HOUR=9
# AI fan comments seeded on each feed post (0 to disable).
FAN_COMMENTS_PER_POST=2
# Fan reaction tweets fired when an Insider report drops.
REACTION_TWEETS_PER_REPORT=3

# --- Misc ---
STATE_DB=data/state.db
LOG_LEVEL=INFO
